# ── LLM Configuration ─────────────────────────────────────────────────────────
# LiteLLM model name. Examples:
#   OpenAI:      gpt-4o, gpt-4o-mini
#   Anthropic:   claude-3-5-sonnet-20241022
#   DeepSeek:    deepseek/deepseek-chat
#   Azure:       azure/gpt-4
INSIGHTFORGE_MODEL=gpt-4o
INSIGHTFORGE_API_KEY=sk-your-key-here
INSIGHTFORGE_API_BASE=

# Fallback models (comma-separated) used on rate-limit / errors
INSIGHTFORGE_FALLBACK_MODELS=

# ── Generation ────────────────────────────────────────────────────────────────
INSIGHTFORGE_TEMPERATURE=0.2
INSIGHTFORGE_MAX_TOKENS=8192
INSIGHTFORGE_MAX_ROUNDS=25

# ── Execution / Sandbox ───────────────────────────────────────────────────────
# Executor backend: "docker" (production) or "local" (dev only)
INSIGHTFORGE_EXECUTOR_BACKEND=docker
INSIGHTFORGE_CODE_TIMEOUT=300
INSIGHTFORGE_DOCKER_IMAGE=insightforge/sandbox:latest
INSIGHTFORGE_DOCKER_MEMORY_LIMIT=2g
INSIGHTFORGE_DOCKER_CPU_LIMIT=1.0
INSIGHTFORGE_DOCKER_NETWORK=none

# ── Workspace & Storage ───────────────────────────────────────────────────────
INSIGHTFORGE_WORKSPACE=./workspace
INSIGHTFORGE_SESSION_BACKEND=sqlite
INSIGHTFORGE_SESSION_DB_URL=sqlite+aiosqlite:///./sessions.db

# ── Server ────────────────────────────────────────────────────────────────────
INSIGHTFORGE_HOST=0.0.0.0
INSIGHTFORGE_PORT=8787
INSIGHTFORGE_API_KEY=
INSIGHTFORGE_REQUIRE_API_KEY=false
INSIGHTFORGE_CORS_ORIGINS=*

# ── Rate Limiting ─────────────────────────────────────────────────────────────
INSIGHTFORGE_RATE_LIMIT_PER_MINUTE=60
INSIGHTFORGE_MAX_TOKENS_PER_RUN=200000

# ── Observability ─────────────────────────────────────────────────────────────
INSIGHTFORGE_OBSERVABILITY_ENABLED=false
INSIGHTFORGE_OBSERVABILITY_PROVIDER=langfuse
INSIGHTFORGE_LANGFUSE_PUBLIC_KEY=
INSIGHTFORGE_LANGFUSE_SECRET_KEY=
INSIGHTFORGE_LANGFUSE_HOST=https://cloud.langfuse.com